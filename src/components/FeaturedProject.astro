---
interface Props {
  title?: string;
  role?: string;
  year?: number | string;
  href?: string;
  class?: string;
}

const {
  title,
  role,
  year,
  href = '#',
  class: className = '',
} = Astro.props;
---

<a href={href} class:list={['featured-project', className]}>
  {
    title ? (
      <div class="featured-project__body">
        <p class="featured-project__title">{title}</p>
        <div class="featured-project__meta">
          {role && <span>{role}</span>}
          {year && <time>{year}</time>}
        </div>
      </div>
    ) : (
      <span class="sr-only">Featured project</span>
    )
  }
</a>

<style>
  .featured-project {
    display: block;
    width: 100%;
    height: 160px;
    border-radius: var(--radius-xl);
    background: var(--color-bg-secondary);
    padding: calc(var(--spacing) * 5);
    color: inherit;
    text-decoration: none;
    transition: background-color 120ms ease;
  }

  .featured-project:hover {
    background: var(--color-bg-secondary_hover);
  }

  .featured-project__body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .featured-project__title {
    font-size: var(--text-md);
    line-height: var(--text-md--line-height);
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0;
  }

  .featured-project__meta {
    display: flex;
    justify-content: space-between;
    color: var(--color-text-quaternary);
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
