---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CameraLensIcon from '../assets/icon/icon-camera-lens.svg';

interface Props {
  title: string;
  year: number | string;
  lede?: string;
  href: string;
  thumbnail?: ImageMetadata;
  thumbnailAlt?: string;
  photoEssay?: boolean;
  class?: string;
}

const {
  title,
  year,
  lede,
  href,
  thumbnail,
  thumbnailAlt = '',
  photoEssay = false,
  class: className = '',
} = Astro.props;
---

<a href={href} class:list={['featured-post', className]}>
  <div class="featured-post__thumbnail">
    {
      thumbnail ? (
        <Image
          src={thumbnail}
          alt={thumbnailAlt}
          width={88}
          height={88}
          densities={[2, 3]}
        />
      ) : (
        <div class="featured-post__placeholder" aria-hidden="true" />
      )
    }
  </div>
  <div class="featured-post__body">
    <div class="featured-post__title-row">
      <h3 class="featured-post__title">
        {
          photoEssay && (
            <span class="featured-post__icon" aria-hidden="true">
              <CameraLensIcon />
            </span>
          )
        }{title}
      </h3>
      <time class="featured-post__year">{year}</time>
    </div>
    {lede && <p class="featured-post__lede">{lede}</p>}
  </div>
</a>

<style>
  .featured-post {
    width: calc(100% + var(--spacing) * 4);
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: calc(var(--spacing) * 5);
    align-items: normal;
    padding: calc(var(--spacing) * 2);
    margin-inline: calc(var(--spacing) * -2);
    border-radius: var(--radius-xl);
    color: inherit;
    text-decoration: none;
    transition: background-color 120ms ease;
  }

  .featured-post:hover {
    background: var(--color-bg-secondary);
  }

  @media (width >= 48rem) {
    .featured-post {
      align-items: center;
    }
  }

  .featured-post__thumbnail {
    width: 88px;
    height: 88px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-tertiary);
    flex-shrink: 0;
  }

  .featured-post__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0;
    border-radius: 0;
  }

  .featured-post__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      var(--color-bg-tertiary),
      var(--color-bg-quaternary)
    );
  }

  .featured-post__body {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 0.5);
    min-width: 0;
  }

  .featured-post__title-row {
    display: flex;
    align-items: baseline;
    gap: calc(var(--spacing) * 3);
    width: 100%;
  }

  .featured-post__title {
    flex: 1;
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--text-md--line-height);
    font-weight: 500;
    color: var(--color-text-primary);
    min-width: 0;
  }

  .featured-post__icon {
    display: inline-block;
    width: 20px;
    height: 20px;
    margin-right: calc(var(--spacing) * 1.5);
    vertical-align: middle;
    color: var(--color-fg-quaternary);
    transform: translateY(-1px);
  }

  .featured-post__year {
    color: var(--color-text-quaternary);
    font-size: var(--text-md);
    line-height: var(--text-md--line-height);
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .featured-post__lede {
    color: var(--color-text-secondary);
    font-size: var(--text-md);
    line-height: var(--text-md--line-height);
    margin: 0;
  }
</style>
