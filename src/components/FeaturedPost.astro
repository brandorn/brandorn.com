---
import Icon from './Icon.astro';

interface Props {
  title: string;
  year: number | string;
  lede?: string;
  href: string;
  thumbnail?: string;
  thumbnailAlt?: string;
  photoEssay?: boolean;
  class?: string;
}

const {
  title,
  year,
  lede,
  href,
  thumbnail,
  thumbnailAlt = '',
  photoEssay = false,
  class: className = '',
} = Astro.props;
---

<article class:list={['featured-post', className]}>
  <a href={href} class="featured-post__link">
    <div class="featured-post__thumbnail">
      {
        thumbnail ? (
          <img src={thumbnail} alt={thumbnailAlt} />
        ) : (
          <div class="featured-post__placeholder" aria-hidden="true" />
        )
      }
    </div>
    <div class="featured-post__body">
      <div class="featured-post__title-row">
        <h3 class="featured-post__title">
          {photoEssay && <Icon name="camera-lens" class="featured-post__icon" />}
          <span>{title}</span>
        </h3>
        <time class="featured-post__year">{year}</time>
      </div>
      {lede && <p class="featured-post__lede">{lede}</p>}
    </div>
  </a>
</article>

<style>
  .featured-post {
    width: 100%;
  }

  .featured-post__link {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: calc(var(--spacing) * 5);
    align-items: center;
    padding: calc(var(--spacing) * 1) calc(var(--spacing) * 2);
    margin-inline: calc(var(--spacing) * -2);
    border-radius: var(--radius-xl);
    color: inherit;
    text-decoration: none;
    transition: background-color 120ms ease;
  }

  .featured-post__link:hover {
    background: var(--color-bg-secondary);
  }

  .featured-post__thumbnail {
    width: 88px;
    height: 88px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-tertiary);
    flex-shrink: 0;
  }

  .featured-post__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0;
    border-radius: 0;
  }

  .featured-post__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      var(--color-bg-tertiary),
      var(--color-bg-quaternary)
    );
  }

  .featured-post__body {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 0.5);
    min-width: 0;
  }

  .featured-post__title-row {
    display: flex;
    align-items: baseline;
    gap: calc(var(--spacing) * 3);
    width: 100%;
  }

  .featured-post__title {
    flex: 1;
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--text-md--line-height);
    font-weight: 500;
    color: var(--color-text-primary);
    display: inline-flex;
    align-items: baseline;
    gap: calc(var(--spacing) * 1.5);
    min-width: 0;
  }

  .featured-post__icon {
    color: var(--color-fg-quaternary);
    align-self: center;
    flex-shrink: 0;
  }

  .featured-post__year {
    color: var(--color-text-quaternary);
    font-size: var(--text-md);
    line-height: var(--text-md--line-height);
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .featured-post__lede {
    color: var(--color-text-secondary);
    font-size: var(--text-md);
    line-height: var(--text-md--line-height);
    margin: 0;
  }
</style>
