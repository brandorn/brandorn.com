---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['header-intro flex flex-col gap-6', className]}>
  <div class="prose-intro text-secondary">
    <slot />
  </div>
  <div class="flex gap-4 items-start">
    <slot name="ctas" />
  </div>
</div>

<style>
  .prose-intro :global(p) {
    margin: 0;
  }

  .prose-intro :global(p + p) {
    margin-top: 1em;
  }

  .prose-intro :global(p:last-child) {
    color: var(--color-text-quaternary);
  }

  .prose-intro :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
