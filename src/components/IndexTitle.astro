---
interface Props {
  description?: string;
  class?: string;
}

const { description, class: className = '' } = Astro.props;
---

<header class:list={['index-title', className]}>
  <h2 class="index-title__h2">
    <slot />
  </h2>
  {description && <p class="index-title__description">{description}</p>}
</header>

<style>
  .index-title {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxs);
  }

  .index-title__h2 {
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0;
  }

  .index-title__description {
    font-size: var(--text-md);
    line-height: var(--text-md--line-height);
    color: var(--color-text-tertiary);
    margin: 0;
  }
</style>
