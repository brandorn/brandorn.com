---
interface Props {
  attribution?: string;
}

const { attribution } = Astro.props;
---

<aside class="intro-quote">
  <div class="intro-quote__body">
    <slot />
  </div>
  {attribution && <p class="intro-quote__attribution">— {attribution}</p>}
</aside>

<style>
  .intro-quote {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 2);
    padding-left: calc(var(--spacing) * 5);
    padding-bottom: calc(var(--spacing) * 2);
    color: var(--color-text-tertiary);
    width: 100%;
  }

  .intro-quote__body {
    font-size: var(--text-md);
    line-height: var(--text-md--line-height);
  }

  .intro-quote__body :global(p) {
    margin: 0;
  }

  .intro-quote__attribution {
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    font-weight: 500;
    margin: 0;
  }

  @media (width >= 48rem) {
    .intro-quote {
      padding-left: calc(var(--spacing) * 10);
    }
  }
</style>
