---
interface Props {
  clients?: string[];
}

const defaultClients = [
  'Arcadia Energy',
  'Circ',
  'CyberGRX',
  'The Gates Foundation',
  'National Public Media',
  'Nest Realty',
  'Pivotal',
  'Privia Health',
  'Rotary International',
  'Standard AI',
  'The Nature Conservancy',
  'The University of Chicago',
  'The University of Virginia',
  'Volunteers of America',
  'Wildlife Conservation Society',
];

const { clients = defaultClients } = Astro.props;

const desktopCols = 3;
const desktopRows = Math.ceil(clients.length / desktopCols);
---

<section class="clients">
  <h3 class="clients__heading">Select clients</h3>
  <ul class="clients__list" style={`--clients-rows: ${desktopRows};`}>
    {clients.map((name) => <li>{name}</li>)}
  </ul>
</section>

<style>
  .clients {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 4);
    width: 100%;
    container-type: inline-size;
  }

  .clients__heading {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--text-md--line-height);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .clients__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: calc(var(--spacing) * 6);
    row-gap: calc(var(--spacing) * 1);
    color: var(--color-text-tertiary);
  }

  .clients__list li {
    margin: 0;
  }

  /* When the container has enough room for 3 content-sized columns,
     switch to column-first ordering so each column hugs its widest item.
     Threshold is set just under the container's max width on this page
     (~35rem when page-home__inner hits its 960px cap); below it we keep
     the 2-col 1fr fallback above to avoid overflow. */
  @container (min-width: 34rem) {
    .clients__list {
      grid-template-columns: none;
      grid-template-rows: repeat(var(--clients-rows), auto);
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      column-gap: calc(var(--spacing) * 6);
    }
  }
</style>
