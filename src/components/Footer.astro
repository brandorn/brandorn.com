---
import { getCollection } from 'astro:content';
import { getAllPosts } from '../lib/posts';
import IndexContainer from './IndexContainer.astro';
import PostListItem from './PostListItem.astro';
import Affinities from './Affinities.astro';
import { CONTACT_EMAIL_HREF } from '../lib/site';

interface Props {
  showPosts?: boolean;
}

const { showPosts = true } = Astro.props;

const posts = showPosts ? await getAllPosts() : [];

const affinities = (await getCollection('affinity')).sort(
  (a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity),
);

const links = [
  { label: 'Email', href: CONTACT_EMAIL_HREF },
  { label: 'Research mode', href: '#' },
  { label: 'Gratitude', href: '#' },
  { label: "Kelly's Bandcamp", href: 'https://kellyreed.bandcamp.com/' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    {
      showPosts && posts.length > 0 && (
        <IndexContainer
          title="Posts"
          description="Occasional essays and visual miscellanea"
        >
          <ul slot="list" class="site-footer__posts">
            {posts.map(({ entry, photoEssay }) => (
              <li>
                <PostListItem
                  title={entry.data.title}
                  year={entry.data.year}
                  href={`/${entry.id}`}
                  photoEssay={photoEssay}
                />
              </li>
            ))}
          </ul>
        </IndexContainer>
      )
    }

    <div class="site-footer__links">
      <ul class="site-footer__nav" aria-label="Site links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <p class="site-footer__copy">© {year} Brandon Dorn</p>
    </div>

    <Affinities affinities={affinities} />
  </div>
</footer>

<style>
  .site-footer {
    padding-inline: calc(var(--spacing) * 4);
    padding-bottom: calc(var(--spacing) * 24);
  }

  .site-footer__inner {
    max-width: 960px;
    margin-inline: auto;
  }

  .site-footer__inner > :global(.index-container) {
    margin-top: calc(var(--spacing) * 24);
    border-top: 1px solid var(--color-border-secondary);
  }

  @media (width >= 48rem) {
    .site-footer {
      padding-inline: calc(var(--spacing) * 10);
    }
  }

  .site-footer__posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 1);
  }

  .site-footer__posts > li {
    margin: 0;
  }

  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 4);
    padding-block: calc(var(--spacing) * 6);
    border-top: 1px solid var(--color-border-secondary);
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    margin-bottom: calc(var(--spacing) * 2);
    color: var(--color-text-tertiary);
  }

  .site-footer__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing) * 4);
  }

  .site-footer__nav > li {
    margin: 0;
  }

  .site-footer__nav a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-border-primary);
    transition: text-decoration-color 120ms ease;
  }

  .site-footer__nav a:hover {
    text-decoration-color: currentColor;
  }

  .site-footer__copy {
    color: inherit;
    margin: 0;
  }

  @media (width >= 48rem) {
    .site-footer__links {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: calc(var(--spacing) * 8);
    }
  }
</style>
