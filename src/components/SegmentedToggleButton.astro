---
import type { HTMLAttributes } from 'astro/types';

/**
 * One button in a `<SegmentedToggle>`. Forwards arbitrary HTML attributes so
 * consumers can attach data-* hooks for their own JS. `pressed` controls the
 * initial `aria-pressed` value (and thus the active visual state).
 */
interface Props extends HTMLAttributes<'button'> {
  pressed?: boolean;
}

const {
  pressed = false,
  class: className,
  type = 'button',
  ...rest
} = Astro.props;
---

<button
  type={type}
  class:list={['segmented-toggle__button', className]}
  aria-pressed={pressed ? 'true' : 'false'}
  {...rest}
>
  <slot />
</button>

<style>
  .segmented-toggle__button {
    appearance: none;
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    padding: calc(var(--spacing) * 1) calc(var(--spacing) * 2);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: var(--text-sm--line-height);
    color: var(--color-text-tertiary);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--spacing) * 1.5);
    transition:
      background-color 120ms ease,
      color 120ms ease;
  }

  .segmented-toggle__button:hover {
    color: var(--color-text-primary);
  }

  .segmented-toggle__button[aria-pressed='true'] {
    background: var(--color-bg-tertiary);
  }

  .segmented-toggle__button:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .segmented-toggle__button :global(svg) {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }
</style>
