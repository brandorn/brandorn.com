---
interface Props {
  title: string;
  lede?: string;
  heroImage?: string;
  heroAlt?: string;
  heroCaption?: string;
  heroCaptionItalic?: string;
}

const {
  title,
  lede,
  heroImage,
  heroAlt = '',
  heroCaption,
  heroCaptionItalic,
} = Astro.props;

const hasPhoto = !!heroImage;
---

<header class:list={['post-header', hasPhoto && 'post-header--has-photo']}>
  <div class="post-header__title-container">
    <h1 class="post-header__title">{title}</h1>
    {lede && <p class="post-header__lede">{lede}</p>}
  </div>

  {
    hasPhoto && (
      <figure class="post-header__cover">
        <img src={heroImage} alt={heroAlt} />
        {(heroCaption || heroCaptionItalic) && (
          <figcaption>
            {heroCaptionItalic && <em>{heroCaptionItalic}</em>}
            {heroCaptionItalic && heroCaption && ', '}
            {heroCaption}
          </figcaption>
        )}
      </figure>
    )
  }
</header>

<style>
  .post-header {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 8);
    width: 100%;
    align-items: center;
  }

  .post-header--has-photo {
    gap: calc(var(--spacing) * 12);
  }

  .post-header__title-container {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 2);
    text-align: center;
    color: var(--color-text-primary);
    max-width: 600px;
    width: 100%;
  }

  .post-header__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-display-sm);
    line-height: var(--text-display-sm--line-height);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .post-header__lede {
    font-size: var(--text-md);
    line-height: var(--text-md--line-height);
    color: var(--color-text-primary);
    margin: 0;
  }

  .post-header__cover {
    margin: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--spacing) * 1.5);
  }

  .post-header__cover img {
    width: 100%;
    aspect-ratio: 594 / 392;
    object-fit: cover;
    border-radius: 0;
    margin: 0;
  }

  .post-header__cover figcaption {
    color: var(--color-text-quaternary);
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    text-align: center;
    display: block;
  }

  .post-header__cover figcaption em {
    font-style: italic;
  }

  @media (width >= 48rem) {
    .post-header__title {
      font-size: var(--text-display-xl);
      line-height: var(--text-display-xl--line-height);
      letter-spacing: var(--text-display-xl--letter-spacing);
    }
  }
</style>
