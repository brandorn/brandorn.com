---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<nav class:list={['post-nav', className]} aria-label="Site">
  <a href="/" class="post-nav__brand">Brandon Dorn</a>
  <ul class="post-nav__links">
    <li>
      <a href="mailto:hello@brandorn.com">Email</a>
    </li>
    <li>
      <a href="/#about">Info</a>
    </li>
  </ul>
</nav>

<style>
  .post-nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: calc(var(--spacing) * 4);
    border-bottom: 1px solid var(--color-border-secondary);
    width: 100%;
  }

  .post-nav__brand {
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .post-nav__brand:hover {
    color: var(--color-text-secondary_hover);
  }

  .post-nav__links {
    display: flex;
    gap: calc(var(--spacing) * 4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-nav__links li {
    margin: 0;
  }

  .post-nav__links a {
    font-weight: 500;
    color: var(--color-text-tertiary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-nav__links a:hover {
    color: var(--color-text-secondary_hover);
  }
</style>
