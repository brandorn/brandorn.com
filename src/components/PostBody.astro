---
interface Props {
  publishedLabel?: string;
  acknowledgements?: string;
}

const { publishedLabel, acknowledgements } = Astro.props;
---

<div class="post-body">
  <div class="post-body__prose">
    <slot />
  </div>

  {
    (publishedLabel || acknowledgements) && (
      <div class="post-body__acknowledgements">
        {publishedLabel && <p class="post-body__date">{publishedLabel}</p>}
        {acknowledgements && <p class="post-body__thanks">{acknowledgements}</p>}
      </div>
    )
  }
</div>

<style>
  .post-body {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 8);
    max-width: 600px;
    width: 100%;
  }

  .post-body__prose {
    color: var(--color-text-primary);
  }

  .post-body__prose :global(> :first-child) {
    margin-top: 0;
  }

  .post-body__prose :global(> :last-child) {
    margin-bottom: 0;
  }

  .post-body__acknowledgements {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 2);
  }

  .post-body__date {
    color: var(--color-text-primary);
    margin: 0;
  }

  .post-body__thanks {
    color: var(--color-text-quaternary);
    margin: 0;
  }
</style>
