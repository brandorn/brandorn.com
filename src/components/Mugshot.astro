---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata | string;
  alt?: string;
  caption?: string;
  class?: string;
}

const {
  src,
  alt = 'Brandon Dorn',
  caption,
  class: className = '',
} = Astro.props;

const isImageMetadata = (s: unknown): s is ImageMetadata =>
  typeof s === 'object' && s !== null && 'src' in s;
---

<figure class:list={['mugshot flex flex-col items-center m-0', className]}>
  <div class="mugshot__frame">
    {
      src ? (
        isImageMetadata(src) ? (
          <Image src={src} alt={alt} widths={[320, 640]} sizes="(min-width: 48rem) 320px, 100vw" />
        ) : (
          <img src={src} alt={alt} />
        )
      ) : (
        <div class="mugshot__placeholder" aria-label="Portrait placeholder" />
      )
    }
  </div>
  {caption && <figcaption class="mugshot__caption">{caption}</figcaption>}
</figure>

<style>
  .mugshot {
    gap: var(--spacing-md);
  }

  .mugshot__frame {
    width: 100%;
    max-width: 240px;
    aspect-ratio: 320 / 400;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-bg-tertiary);
  }

  @media (width >= 48rem) {
    .mugshot__frame {
      max-width: none;
    }
  }

  .mugshot__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0;
    border-radius: 0;
  }

  .mugshot__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      var(--color-bg-tertiary),
      var(--color-bg-quaternary)
    );
  }

  .mugshot__caption {
    font-size: var(--text-xs);
    line-height: var(--text-xs--line-height);
    color: var(--color-text-quaternary);
    text-align: center;
    margin: 0;
  }
</style>
