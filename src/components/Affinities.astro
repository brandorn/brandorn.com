---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { emphasize, stripEmphasis } from '../lib/inline-markdown';
import SegmentedToggle from './SegmentedToggle.astro';
import SegmentedToggleButton from './SegmentedToggleButton.astro';

interface Props {
  affinities: CollectionEntry<'affinity'>[];
}

const { affinities } = Astro.props;

// Pre-compute optimized image URLs for the cursor-following list popover. The
// grid view uses Astro's <Image /> directly, but the list popover swaps `src`
// imperatively from JS so it needs a plain URL string in a data attribute.
const popoverImages = await Promise.all(
  affinities.map((a) => getImage({ src: a.data.image, width: 480 })),
);
---

<section class="affinities">
  <header class="affinities__header">
    <div class="affinities__title">
      <h2 class="affinities__heading">Affinities</h2>
      <p class="affinities__description">Starter pack for being me</p>
    </div>
    <SegmentedToggle ariaLabel="Affinity view">
      <SegmentedToggleButton data-view-target="list" pressed>
        List
      </SegmentedToggleButton>
      <SegmentedToggleButton data-view-target="grid">
        Grid
      </SegmentedToggleButton>
    </SegmentedToggle>
  </header>

  <div class="affinities__body" data-view="list" data-expanded="false">
    <div class="affinities__viewport">
      <ul class="affinity-list" data-view-content="list">
        {
          affinities.map((a, i) => (
            <li class="affinity-list__item">
              <a
                class="affinity-list__link"
                href={a.data.url}
                data-affinity-image={popoverImages[i].src}
                data-affinity-title={stripEmphasis(a.data.title)}
                set:html={emphasize(a.data.title)}
              />
            </li>
          ))
        }
      </ul>

      <ul class="affinity-grid" data-view-content="grid">
        {
          affinities.map((a) => (
            <li class="affinity-grid__item">
              <a
                class="affinity-grid__link"
                href={a.data.url}
                data-affinity-title={stripEmphasis(a.data.title)}
                aria-label={stripEmphasis(a.data.title)}
              >
                <Image
                  src={a.data.image}
                  alt=""
                  widths={[240, 480]}
                  sizes="(min-width: 64rem) 160px, (min-width: 48rem) 25vw, 33vw"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <button type="button" class="affinities__more" aria-expanded="false">
      More affinities
    </button>
  </div>

  <div class="affinity-popover" aria-hidden="true" hidden>
    <img class="affinity-popover__image" src="" alt="" />
    <span class="affinity-popover__text"></span>
  </div>
</section>

<style>
  .affinities {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 2);
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--color-text-tertiary);
  }

  /* Header (title + description on the left, toggle on the right) */
  .affinities__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: calc(var(--spacing) * 4);
  }

  .affinities__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: calc(var(--spacing) * 3);
  }

  .affinities__heading {
    font-size: inherit;
    line-height: inherit;
    font-weight: 500;
    color: inherit;
    margin: 0;
  }

  .affinities__description {
    color: inherit;
    margin: 0;
  }

  /* Body — viewport + scrim + reveal */
  .affinities__body {
    position: relative;
  }

  .affinities__viewport {
    position: relative;
    overflow: hidden;
    max-height: 9rem;
    transition: max-height 240ms ease;
  }

  /* The scrim — gradient + the "More affinities" button overlay */
  .affinities__viewport::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 4rem;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-bg-primary)
    );
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .affinities__body[data-expanded='true'] .affinities__viewport::after {
    opacity: 0;
  }

  .affinities__more {
    display: block;
    margin: calc(var(--spacing) * -1) auto 0;
    width: max-content;
    appearance: none;
    background: transparent;
    border: none;
    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 4);
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    font-weight: 500;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .affinities__more:hover {
    color: var(--color-text-primary_hover);
  }

  .affinities__body[data-expanded='true'] .affinities__more {
    display: none;
  }

  /* View visibility */
  .affinities__body[data-view='list'] [data-view-content='grid'] {
    display: none;
  }

  .affinities__body[data-view='grid'] [data-view-content='list'] {
    display: none;
  }

  /* Grow the viewport cap a bit in grid mode so 2 image rows are visible */
  .affinities__body[data-view='grid'] .affinities__viewport {
    max-height: 14rem;
  }

  /* Expanded — must come after the per-view caps above so it wins regardless
     of which view is active. */
  .affinities__body[data-expanded='true'] .affinities__viewport {
    max-height: none;
  }

  /* List view — rendered as flowing inline text so titles can wrap mid-link
     instead of dropping whole "bricks" to the next line. */
  .affinity-list {
    list-style: none;
    margin: 0;
    padding: 0;
    color: inherit;
    line-height: calc(var(--spacing) * 6.5);
  }

  .affinity-list__item {
    display: inline;
    margin: 0;
  }

  /* Light circle separator between items — purely presentational. Rendered
     as an inline-block so it sits in flow as a soft-wrap opportunity, which
     keeps the wall-of-text feel intact. */
  .affinity-list__item + .affinity-list__item::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-fg-disabled_subtle);
    margin-inline: calc(var(--spacing));
    vertical-align: 0.25em;
  }

  .affinity-list__link {
    color: inherit;
    text-decoration: none;
  }

  .affinity-list__link:hover {
    color: var(--color-text-primary_hover);
  }

  .affinity-list__link em {
    font-style: italic;
  }

  /* Grid view — CSS Grid with responsive column counts. (Switched from
     CSS multi-column because column-fill: balance can leave the last column
     empty when the item count doesn't divide evenly.) When affinities have
     varying image aspect ratios in the future, we can add a row-span trick
     to recover a masonry feel. */
  .affinity-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: calc(var(--spacing) * 2);
  }

  @media (width >= 30rem) {
    .affinity-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (width >= 48rem) {
    .affinity-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  @media (width >= 64rem) {
    .affinity-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .affinity-grid__item {
    margin: 0;
    min-width: 0;
  }

  .affinity-grid__link {
    display: block;
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: transform 200ms ease;
  }

  .affinity-grid__link:hover {
    transform: scale(1.02);
  }

  .affinity-grid__link :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }

  /* Popover / tooltip — single shared element. */
  .affinity-popover {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    pointer-events: none;
    transform: translate3d(var(--popover-x, 0), var(--popover-y, 0), 0)
      rotate(var(--popover-skew, 0deg));
    transition: opacity 120ms ease;
    opacity: 0;
  }

  .affinity-popover[data-visible='true'] {
    opacity: 1;
  }

  /* Image popover (list mode) */
  .affinity-popover[data-mode='image'] .affinity-popover__image {
    display: block;
    width: 240px;
    max-width: 50vw;
    height: auto;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
  }

  .affinity-popover[data-mode='image'] .affinity-popover__text {
    display: none;
  }

  /* Text tooltip (grid mode) — theme-inverted via existing tokens. */
  .affinity-popover[data-mode='text'] .affinity-popover__image {
    display: none;
  }

  .affinity-popover[data-mode='text'] .affinity-popover__text {
    display: inline-block;
    padding: calc(var(--spacing) * 1.5) calc(var(--spacing) * 2.5);
    border-radius: var(--radius-sm);
    background: var(--color-text-primary);
    color: var(--color-bg-primary);
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    white-space: nowrap;
    box-shadow: var(--shadow-md);
  }

  .affinity-popover__image {
    display: none;
  }

  .affinity-popover__text {
    display: none;
  }

  /* Disable cursor-following hover effects on touch input. */
  @media (hover: none) {
    .affinity-popover {
      display: none;
    }
  }
</style>

<script>
  // All affinity interactivity in one place: list/grid toggle, "More
  // affinities" reveal, and the cursor-following popover/tooltip.

  const initAffinities = () => {
    document.querySelectorAll<HTMLElement>('.affinities').forEach((root) => {
      const body = root.querySelector<HTMLElement>('.affinities__body');
      const popover = root.querySelector<HTMLElement>('.affinity-popover');
      if (!body || !popover) return;

      const popoverImage = popover.querySelector<HTMLImageElement>(
        '.affinity-popover__image',
      );
      const popoverText = popover.querySelector<HTMLElement>(
        '.affinity-popover__text',
      );
      if (!popoverImage || !popoverText) return;

      // List/Grid toggle
      const toggleButtons = root.querySelectorAll<HTMLButtonElement>(
        '[data-view-target]',
      );
      toggleButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const target = button.dataset.viewTarget;
          if (!target) return;
          body.dataset.view = target;
          toggleButtons.forEach((b) => {
            b.setAttribute(
              'aria-pressed',
              b === button ? 'true' : 'false',
            );
          });
          hidePopover();
        });
      });

      // "More affinities" reveal
      const moreButton = root.querySelector<HTMLButtonElement>(
        '.affinities__more',
      );
      moreButton?.addEventListener('click', () => {
        body.dataset.expanded = 'true';
        moreButton.setAttribute('aria-expanded', 'true');
      });

      // Cursor-following popover (list) / tooltip (grid)
      const PAD = 16;
      const OFFSET_X = 18;
      const OFFSET_Y = 18;

      const hidePopover = () => {
        popover.dataset.visible = 'false';
        popover.hidden = true;
      };

      const positionPopover = (event: MouseEvent) => {
        const rect = popover.getBoundingClientRect();
        const w = rect.width || 240;
        const h = rect.height || 160;

        let x = event.clientX + OFFSET_X;
        let y = event.clientY + OFFSET_Y;

        // Flip / clamp so the popover stays in the viewport.
        if (x + w + PAD > window.innerWidth) {
          x = event.clientX - w - OFFSET_X;
        }
        if (y + h + PAD > window.innerHeight) {
          y = event.clientY - h - OFFSET_Y;
        }
        x = Math.max(PAD, Math.min(x, window.innerWidth - w - PAD));
        y = Math.max(PAD, Math.min(y, window.innerHeight - h - PAD));

        popover.style.setProperty('--popover-x', `${x}px`);
        popover.style.setProperty('--popover-y', `${y}px`);
      };

      const wireHover = (
        link: HTMLElement,
        mode: 'image' | 'text',
        payload: { image?: string; text?: string },
      ) => {
        link.addEventListener('mouseenter', (event) => {
          popover.dataset.mode = mode;
          if (mode === 'image' && payload.image) {
            popoverImage.src = payload.image;
            popoverImage.alt = payload.text ?? '';
            // Random skew between -4 and +4 degrees per hover.
            const skew = (Math.random() * 8 - 4).toFixed(2);
            popover.style.setProperty('--popover-skew', `${skew}deg`);
          } else if (mode === 'text' && payload.text) {
            popoverText.textContent = payload.text;
            popover.style.setProperty('--popover-skew', '0deg');
          }
          popover.hidden = false;
          // Position before showing to avoid a flash at (0,0).
          positionPopover(event as MouseEvent);
          requestAnimationFrame(() => {
            popover.dataset.visible = 'true';
          });
        });

        link.addEventListener('mousemove', (event) => {
          positionPopover(event as MouseEvent);
        });

        link.addEventListener('mouseleave', hidePopover);
      };

      root
        .querySelectorAll<HTMLElement>('.affinity-list__link')
        .forEach((link) => {
          wireHover(link, 'image', {
            image: link.dataset.affinityImage,
            text: link.dataset.affinityTitle,
          });
        });

      root
        .querySelectorAll<HTMLElement>('.affinity-grid__link')
        .forEach((link) => {
          wireHover(link, 'text', {
            text: link.dataset.affinityTitle,
          });
        });
    });
  };

  initAffinities();
  document.addEventListener('astro:page-load', initAffinities);
</script>
