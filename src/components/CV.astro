---
import CVItem from './CVItem.astro';
import CTA from './CTA.astro';

interface CVEntry {
  employer: string;
  role: string;
  dates: string;
}

interface Props {
  items?: CVEntry[];
  cvDownloadHref?: string;
}

const defaultItems: CVEntry[] = [
  { employer: 'TravelJoy', role: 'Staff product designer', dates: '2024 - present' },
  { employer: 'Whimsical', role: 'Lead product designer', dates: '2022 - 2024' },
  { employer: 'Dwell', role: 'Lead product designer', dates: '2021 - 2022' },
  { employer: 'Viget', role: 'Senior product designer', dates: '2015 - 2021' },
  { employer: 'State Farm', role: 'Systems Analyst', dates: '2013 - 2015' },
  { employer: 'Leo Burnett', role: 'Account Planner', dates: '2011 - 2013' },
];

const { items = defaultItems, cvDownloadHref = '#' } = Astro.props;
---

<section class="cv">
  <header class="cv__header">
    <h3 class="cv__heading">Experience</h3>
    <CTA href={cvDownloadHref}>Download CV</CTA>
  </header>
  <ol class="cv__list">
    {
      items.map((item) => (
        <li>
          <CVItem {...item} />
        </li>
      ))
    }
  </ol>
</section>

<style>
  .cv {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 3);
    width: 100%;
  }

  .cv__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: calc(var(--spacing) * 3);
  }

  .cv__heading {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--text-md--line-height);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .cv__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 3);
  }

  .cv__list > li {
    margin: 0;
    padding: 0;
  }

  .cv__list > li + li {
    border-top: 1px solid var(--color-border-secondary);
    padding-top: calc(var(--spacing) * 3);
  }
</style>
