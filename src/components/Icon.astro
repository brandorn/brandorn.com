---
interface Props {
  name:
    | 'align-left'
    | 'face-id-square'
    | 'camera-lens'
    | 'arrow-up-right'
    | 'chevron-left';
  class?: string;
  size?: number;
  'aria-hidden'?: boolean;
}

const {
  name,
  class: className = '',
  size = 20,
  'aria-hidden': ariaHidden = true,
} = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={ariaHidden}
  class={className}
>
  {
    name === 'align-left' && (
      <>
        <line x1="3" y1="5" x2="17" y2="5" />
        <line x1="3" y1="10" x2="13" y2="10" />
        <line x1="3" y1="15" x2="15" y2="15" />
      </>
    )
  }
  {
    name === 'face-id-square' && (
      <>
        <rect x="2.5" y="2.5" width="15" height="15" rx="2" />
        <path d="M7 8.5v1" />
        <path d="M13 8.5v1" />
        <path d="M10 7v3.5" />
        <path d="M7 13c.75.75 1.75 1.25 3 1.25s2.25-.5 3-1.25" />
      </>
    )
  }
  {
    name === 'camera-lens' && (
      <>
        <circle cx="10" cy="10" r="7" />
        <circle cx="10" cy="10" r="3" />
      </>
    )
  }
  {
    name === 'arrow-up-right' && (
      <>
        <path d="M6 14 14 6" />
        <path d="M7 6h7v7" />
      </>
    )
  }
  {
    name === 'chevron-left' && <path d="M12 4 6 10l6 6" />
  }
</svg>
