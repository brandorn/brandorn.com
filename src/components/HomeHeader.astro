---
import type { ImageMetadata } from 'astro';
import HeaderTitle from './HeaderTitle.astro';
import HeaderIntro from './HeaderIntro.astro';
import Mugshot from './Mugshot.astro';
import CTA from './CTA.astro';
import Icon from './Icon.astro';
import mugshotDefault from '../assets/img/mugshot-winter-light.webp';

interface Props {
  mugshotSrc?: ImageMetadata | string;
  mugshotCaption?: string;
}

const {
  mugshotSrc = mugshotDefault,
  mugshotCaption = "It's 32° here, noticeably colder than where you are…",
} = Astro.props;
---

<header class="home-header" data-carousel data-active="text">
  <div class="home-header__main">
    <div class="home-header__text-col">
      <HeaderTitle as="h1">Brandon Dorn</HeaderTitle>

      <section
        class="home-header__pane"
        data-pane="text"
        role="tabpanel"
        id="pane-text"
        aria-labelledby="tab-text"
      >
        <HeaderIntro>
          <p>
            Hey there. I'm Brandon, a product designer from Chicago. I specialize
            in taking purpose-built SaaS products from shaped to shipped. I think
            a lot about systems and craft.
          </p>
          <p>
            Currently staff designer at TravelJoy. Before that, I was a lead
            designer at Whimsical and Dwell, and helped build the product design
            practice at Viget. Doing what I can to <a href="#">care for the world
            and make new, good things</a>. Probably reading a book.
          </p>
          <p>Portfolio and references available upon request.</p>

          <Fragment slot="ctas">
            <CTA href="mailto:hello@brandorn.com">Email me</CTA>
            <CTA href="#about">More info</CTA>
          </Fragment>
        </HeaderIntro>
      </section>
    </div>

    <section
      class="home-header__pane"
      data-pane="portrait"
      role="tabpanel"
      id="pane-portrait"
      aria-labelledby="tab-portrait"
      aria-hidden="true"
    >
      <Mugshot src={mugshotSrc} caption={mugshotCaption} />
    </section>
  </div>

  <div class="home-header__nav" role="tablist" aria-label="Header view">
    <button
      type="button"
      role="tab"
      id="tab-text"
      aria-controls="pane-text"
      aria-selected="true"
      data-target="text"
      class="home-header__nav-button"
    >
      <Icon name="align-left" />
      <span class="sr-only">Text view</span>
    </button>
    <button
      type="button"
      role="tab"
      id="tab-portrait"
      aria-controls="pane-portrait"
      aria-selected="false"
      data-target="portrait"
      class="home-header__nav-button"
    >
      <Icon name="face-id-square" />
      <span class="sr-only">Portrait view</span>
    </button>
  </div>
</header>

<style>
  .home-header {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 6);
  }

  .home-header__pane {
    transition: opacity 200ms ease;
  }

  /* Mobile: title on top, panes stacked & carousel-toggled in a single grid cell */
  @media (width < 48rem) {
    .home-header__main {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-areas:
        'title'
        'pane';
      row-gap: calc(var(--spacing) * 6);
    }

    /* Flatten text-col so its h1 + pane participate in the outer grid */
    .home-header__text-col {
      display: contents;
    }

    .home-header__text-col > :global(h1) {
      grid-area: title;
    }

    .home-header__pane {
      grid-area: pane;
      opacity: 0;
      pointer-events: none;
    }

    .home-header[data-active='text'] [data-pane='text'],
    .home-header[data-active='portrait'] [data-pane='portrait'] {
      opacity: 1;
      pointer-events: auto;
    }
  }

  .home-header__nav {
    display: flex;
    gap: calc(var(--spacing) * 1.5);
    justify-content: center;
    padding: calc(var(--spacing) * 1) 0;
  }

  /* Desktop: text-col and mugshot-pane sit side by side, vertically centered */
  @media (width >= 48rem) {
    .home-header__main {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: calc(var(--spacing) * 16);
    }

    .home-header__text-col {
      display: flex;
      flex-direction: column;
      gap: calc(var(--spacing) * 6);
      flex: 1 1 auto;
      min-width: 0;
    }

    .home-header__pane[data-pane='portrait'] {
      flex: 0 0 320px;
      width: 320px;
    }

    .home-header__nav {
      display: none;
    }
  }

  .home-header__nav-button {
    appearance: none;
    background: var(--color-bg-tertiary);
    border: 0;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm);
    color: var(--color-fg-quaternary);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .home-header__nav-button[aria-selected='true'] {
    background: var(--color-bg-primary-solid);
    color: var(--color-text-primary_on-brand);
  }

  .home-header__nav-button:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-header__pane {
      transition: none;
    }
  }
</style>

<script>
  function initHomeHeader(root: HTMLElement) {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
    );
    const panes = Array.from(
      root.querySelectorAll<HTMLElement>('[data-pane]'),
    );

    const mql = window.matchMedia('(min-width: 48rem)');

    function setActive(target: string) {
      root.dataset.active = target;
      for (const tab of tabs) {
        const selected = tab.dataset.target === target;
        tab.setAttribute('aria-selected', String(selected));
      }
      syncPanes();
    }

    function syncPanes() {
      const target = root.dataset.active ?? 'text';
      for (const pane of panes) {
        if (mql.matches) {
          pane.removeAttribute('aria-hidden');
        } else {
          const isActive = pane.dataset.pane === target;
          pane.setAttribute('aria-hidden', String(!isActive));
        }
      }
    }

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        const target = tab.dataset.target;
        if (target) setActive(target);
      });
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const idx = tabs.indexOf(tab);
          const next = tabs[(idx + 1) % tabs.length];
          next.focus();
          const target = next.dataset.target;
          if (target) setActive(target);
        }
      });
    }

    mql.addEventListener('change', syncPanes);
    syncPanes();
  }

  document
    .querySelectorAll<HTMLElement>('[data-carousel]')
    .forEach(initHomeHeader);
</script>
