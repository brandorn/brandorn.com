---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CTA from './CTA.astro';
import ChevronLeftIcon from '../assets/icon/icon-chevron-left.svg';
import ChevronRightIcon from '../assets/icon/icon-chevron-right.svg';
import mugshotDefault from '../assets/img/mugshot-winter-light.webp';

interface Props {
  mugshotSrc?: ImageMetadata;
  mugshotCaption?: string;
}

const {
  mugshotSrc = mugshotDefault,
  mugshotCaption = "It's 32° here, noticeably colder than where you are…",
} = Astro.props;
---

<header class="home-header" data-carousel data-active="text">
  <div class="home-header__main">
    <div class="home-header__text-col">
      <div class="home-header__title-row">
        <h1 class="home-header__title">Brandon Dorn</h1>
        <div class="home-header__nav" aria-label="Toggle header view">
          <button
            type="button"
            data-direction="prev"
            class="home-header__nav-button"
            disabled
          >
            <ChevronLeftIcon aria-hidden="true" />
            <span class="sr-only">Previous view</span>
          </button>
          <button
            type="button"
            data-direction="next"
            class="home-header__nav-button"
          >
            <ChevronRightIcon aria-hidden="true" />
            <span class="sr-only">Next view</span>
          </button>
        </div>
      </div>

      <section
        class="home-header__pane"
        data-pane="text"
        aria-label="Intro"
      >
        <div class="home-header__intro">
          <div class="home-header__intro-prose">
            <p>
              Hey there. I'm Brandon, a product designer from Chicago. I specialize
              in taking purpose-built SaaS products from shaped to shipped. I think
              a lot about systems and craft.
            </p>
            <p>
              Currently staff designer at TravelJoy. Before that, I was a lead
              designer at Whimsical and Dwell, and helped build the product design
              practice at Viget. Doing what I can to <a href="https://www.paulgraham.com/do.html">care for the world
              and make new, good things</a>. Probably reading a book.
            </p>
            <p>Portfolio and references available upon request.</p>
          </div>
          <div class="home-header__intro-ctas">
            <CTA href="mailto:hello@brandorn.com">Email me</CTA>
            <CTA href="#about">More info</CTA>
          </div>
        </div>
      </section>
    </div>

    <section
      class="home-header__pane"
      data-pane="portrait"
      aria-label="Portrait"
      aria-hidden="true"
    >
      <figure class="home-header__mugshot">
        <div class="home-header__mugshot-frame">
          <Image
            src={mugshotSrc}
            alt="Brandon Dorn"
            widths={[320, 640]}
            sizes="(min-width: 48rem) 320px, 100vw"
          />
        </div>
        {mugshotCaption && (
          <figcaption class="home-header__mugshot-caption">
            {mugshotCaption}
          </figcaption>
        )}
      </figure>
    </section>
  </div>
</header>

<style>
  .home-header__title {
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0;
  }

  .home-header__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--spacing) * 2);
  }

  .home-header__pane {
    transition: opacity 200ms ease;
  }

  .home-header__intro {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 6);
    max-width: 32rem;
  }

  .home-header__intro-prose {
    color: var(--color-text-secondary);
  }

  .home-header__intro-prose :global(p) {
    margin: 0;
  }

  .home-header__intro-prose :global(p + p) {
    margin-top: 1em;
  }

  .home-header__intro-prose :global(p:last-child) {
    color: var(--color-text-quaternary);
  }

  .home-header__intro-prose :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .home-header__intro-ctas {
    display: flex;
    gap: calc(var(--spacing) * 4);
    align-items: flex-start;
  }

  .home-header__mugshot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
    margin: 0;
  }

  .home-header__mugshot-frame {
    width: 100%;
    max-width: 240px;
    aspect-ratio: 320 / 400;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-bg-tertiary);
  }

  .home-header__mugshot-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0;
    border-radius: 0;
  }

  .home-header__mugshot-caption {
    font-size: var(--text-xs);
    line-height: var(--text-xs--line-height);
    color: var(--color-text-quaternary);
    text-align: center;
    margin: 0;
  }

  .home-header__nav {
    display: flex;
    gap: calc(var(--spacing) * 1);
  }

  .home-header__nav-button {
    appearance: none;
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    padding: calc(var(--spacing) * 1);
    color: var(--color-fg-secondary);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .home-header__nav-button:hover {
    background: var(--color-bg-secondary);
  }

  .home-header__nav-button:disabled {
    color: var(--color-fg-quaternary);
    cursor: default;
    background: transparent;
  }

  .home-header__nav-button:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Mobile: title row + panes share a single grid column,
     so the active pane occupies the same cell regardless of which one is showing. */
  @media (width < 48rem) {
    .home-header__main {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-areas:
        'title'
        'pane';
      row-gap: calc(var(--spacing) * 6);
    }

    /* Flatten text-col so its title-row + pane participate in the outer grid */
    .home-header__text-col {
      display: contents;
    }

    .home-header__title-row {
      grid-area: title;
    }

    .home-header__pane {
      grid-area: pane;
      opacity: 0;
      pointer-events: none;
    }

    .home-header[data-active='text'] [data-pane='text'],
    .home-header[data-active='portrait'] [data-pane='portrait'] {
      opacity: 1;
      pointer-events: auto;
    }
  }

  /* Desktop: text-col and portrait pane sit side by side; toggle is hidden. */
  @media (width >= 48rem) {
    .home-header__main {
      display: flex;
      align-items: center;
      gap: calc(var(--spacing) * 16);
    }

    .home-header__text-col {
      display: flex;
      flex-direction: column;
      gap: calc(var(--spacing) * 6);
      flex: 0 1 auto;
      min-width: 0;
    }

    .home-header__pane[data-pane='portrait'] {
      flex: 0 0 320px;
      width: 320px;
    }

    .home-header__mugshot-frame {
      max-width: none;
    }

    .home-header__nav {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-header__pane {
      transition: none;
    }
  }
</style>

<script>
  function initHomeHeader(root: HTMLElement) {
    const buttons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-direction]'),
    );
    const panes = Array.from(
      root.querySelectorAll<HTMLElement>('[data-pane]'),
    );
    const order = panes.map((p) => p.dataset.pane!).filter(Boolean);

    const mql = window.matchMedia('(min-width: 48rem)');

    function setActive(target: string) {
      root.dataset.active = target;
      syncPanes();
      syncButtons();
    }

    function step(direction: 'prev' | 'next') {
      const current = root.dataset.active ?? order[0];
      const idx = order.indexOf(current);
      const delta = direction === 'next' ? 1 : -1;
      const nextIdx = idx + delta;
      if (nextIdx < 0 || nextIdx >= order.length) return;
      setActive(order[nextIdx]);
    }

    function syncPanes() {
      const target = root.dataset.active ?? order[0];
      for (const pane of panes) {
        if (mql.matches) {
          pane.removeAttribute('aria-hidden');
        } else {
          const isActive = pane.dataset.pane === target;
          pane.setAttribute('aria-hidden', String(!isActive));
        }
      }
    }

    function syncButtons() {
      const idx = order.indexOf(root.dataset.active ?? order[0]);
      for (const button of buttons) {
        const dir = button.dataset.direction;
        const atEdge =
          (dir === 'prev' && idx <= 0) ||
          (dir === 'next' && idx >= order.length - 1);
        button.disabled = atEdge;
      }
    }

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const dir = button.dataset.direction as 'prev' | 'next' | undefined;
        if (dir) step(dir);
      });
    }

    mql.addEventListener('change', syncPanes);
    syncPanes();
    syncButtons();
  }

  document
    .querySelectorAll<HTMLElement>('[data-carousel]')
    .forEach(initHomeHeader);
</script>
