---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CTA from './CTA.astro';
import AlignLeftIcon from '../assets/icon/icon-align-left.svg';
import FaceIdSquareIcon from '../assets/icon/icon-face-id-square.svg';
import mugshotDefault from '../assets/img/mugshot-winter-light.webp';

interface Props {
  mugshotSrc?: ImageMetadata;
  mugshotCaption?: string;
}

const {
  mugshotSrc = mugshotDefault,
  mugshotCaption = "It's 32° here, noticeably colder than where you are…",
} = Astro.props;
---

<header class="home-header" data-carousel data-active="text">
  <div class="home-header__main">
    <div class="home-header__text-col">
      <h1 class="home-header__title">Brandon Dorn</h1>

      <section
        class="home-header__pane"
        data-pane="text"
        role="tabpanel"
        id="pane-text"
        aria-labelledby="tab-text"
      >
        <div class="home-header__intro">
          <div class="home-header__intro-prose">
            <p>
              Hey there. I'm Brandon, a product designer from Chicago. I specialize
              in taking purpose-built SaaS products from shaped to shipped. I think
              a lot about systems and craft.
            </p>
            <p>
              Currently staff designer at TravelJoy. Before that, I was a lead
              designer at Whimsical and Dwell, and helped build the product design
              practice at Viget. Doing what I can to <a href="https://www.paulgraham.com/do.html">care for the world
              and make new, good things</a>. Probably reading a book.
            </p>
            <p>Portfolio and references available upon request.</p>
          </div>
          <div class="home-header__intro-ctas">
            <CTA href="mailto:hello@brandorn.com">Email me</CTA>
            <CTA href="#about">More info</CTA>
          </div>
        </div>
      </section>
    </div>

    <section
      class="home-header__pane"
      data-pane="portrait"
      role="tabpanel"
      id="pane-portrait"
      aria-labelledby="tab-portrait"
      aria-hidden="true"
    >
      <figure class="home-header__mugshot">
        <div class="home-header__mugshot-frame">
          <Image
            src={mugshotSrc}
            alt="Brandon Dorn"
            widths={[320, 640]}
            sizes="(min-width: 48rem) 320px, 100vw"
          />
        </div>
        {mugshotCaption && (
          <figcaption class="home-header__mugshot-caption">
            {mugshotCaption}
          </figcaption>
        )}
      </figure>
    </section>
  </div>

  <div class="home-header__nav" role="tablist" aria-label="Header view">
    <button
      type="button"
      role="tab"
      id="tab-text"
      aria-controls="pane-text"
      aria-selected="true"
      data-target="text"
      class="home-header__nav-button"
    >
      <AlignLeftIcon aria-hidden="true" />
      <span class="sr-only">Text view</span>
    </button>
    <button
      type="button"
      role="tab"
      id="tab-portrait"
      aria-controls="pane-portrait"
      aria-selected="false"
      data-target="portrait"
      class="home-header__nav-button"
    >
      <FaceIdSquareIcon aria-hidden="true" />
      <span class="sr-only">Portrait view</span>
    </button>
  </div>
</header>

<style>
  .home-header {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 6);
  }

  .home-header__title {
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 0;
  }

  .home-header__pane {
    transition: opacity 200ms ease;
  }

  .home-header__intro {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 6);
  }

  .home-header__intro-prose {
    color: var(--color-text-secondary);
  }

  .home-header__intro-prose :global(p) {
    margin: 0;
  }

  .home-header__intro-prose :global(p + p) {
    margin-top: 1em;
  }

  .home-header__intro-prose :global(p:last-child) {
    color: var(--color-text-quaternary);
  }

  .home-header__intro-prose :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .home-header__intro-ctas {
    display: flex;
    gap: calc(var(--spacing) * 4);
    align-items: flex-start;
  }

  .home-header__mugshot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
    margin: 0;
  }

  .home-header__mugshot-frame {
    width: 100%;
    max-width: 240px;
    aspect-ratio: 320 / 400;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-bg-tertiary);
  }

  .home-header__mugshot-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0;
    border-radius: 0;
  }

  .home-header__mugshot-caption {
    font-size: var(--text-xs);
    line-height: var(--text-xs--line-height);
    color: var(--color-text-quaternary);
    text-align: center;
    margin: 0;
  }

  /* Mobile: title on top, panes stacked & carousel-toggled in a single grid cell */
  @media (width < 48rem) {
    .home-header__main {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-areas:
        'title'
        'pane';
      row-gap: calc(var(--spacing) * 6);
    }

    /* Flatten text-col so its h1 + pane participate in the outer grid */
    .home-header__text-col {
      display: contents;
    }

    .home-header__title {
      grid-area: title;
    }

    .home-header__pane {
      grid-area: pane;
      opacity: 0;
      pointer-events: none;
    }

    .home-header[data-active='text'] [data-pane='text'],
    .home-header[data-active='portrait'] [data-pane='portrait'] {
      opacity: 1;
      pointer-events: auto;
    }
  }

  .home-header__nav {
    display: flex;
    gap: calc(var(--spacing) * 1.5);
    justify-content: center;
    padding: calc(var(--spacing) * 1) 0;
  }

  /* Desktop: text-col and mugshot-pane sit side by side, vertically centered */
  @media (width >= 48rem) {
    .home-header__main {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: calc(var(--spacing) * 32);
      margin-bottom: calc(var(--spacing) * 8);
    }

    .home-header__text-col {
      display: flex;
      flex-direction: column;
      gap: calc(var(--spacing) * 6);
      flex: 1 1 auto;
      min-width: 0;
    }

    .home-header__pane[data-pane='portrait'] {
      flex: 0 0 320px;
      width: 320px;
    }

    .home-header__mugshot-frame {
      max-width: none;
    }

    .home-header__nav {
      display: none;
    }
  }

  .home-header__nav-button {
    appearance: none;
    background: var(--color-bg-tertiary);
    border: 0;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm);
    color: var(--color-fg-quaternary);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .home-header__nav-button[aria-selected='true'] {
    background: var(--color-bg-primary-solid);
    color: var(--color-text-primary_on-brand);
  }

  .home-header__nav-button:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-header__pane {
      transition: none;
    }
  }
</style>

<script>
  function initHomeHeader(root: HTMLElement) {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
    );
    const panes = Array.from(
      root.querySelectorAll<HTMLElement>('[data-pane]'),
    );

    const mql = window.matchMedia('(min-width: 48rem)');

    function setActive(target: string) {
      root.dataset.active = target;
      for (const tab of tabs) {
        const selected = tab.dataset.target === target;
        tab.setAttribute('aria-selected', String(selected));
      }
      syncPanes();
    }

    function syncPanes() {
      const target = root.dataset.active ?? 'text';
      for (const pane of panes) {
        if (mql.matches) {
          pane.removeAttribute('aria-hidden');
        } else {
          const isActive = pane.dataset.pane === target;
          pane.setAttribute('aria-hidden', String(!isActive));
        }
      }
    }

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        const target = tab.dataset.target;
        if (target) setActive(target);
      });
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const idx = tabs.indexOf(tab);
          const next = tabs[(idx + 1) % tabs.length];
          next.focus();
          const target = next.dataset.target;
          if (target) setActive(target);
        }
      });
    }

    mql.addEventListener('change', syncPanes);
    syncPanes();
  }

  document
    .querySelectorAll<HTMLElement>('[data-carousel]')
    .forEach(initHomeHeader);
</script>
