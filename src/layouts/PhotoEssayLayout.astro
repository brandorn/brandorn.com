---
import type { ImageMetadata } from 'astro';
import EssayLayout from './EssayLayout.astro';

interface Props {
  title: string;
  lede?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  coverCaption?: string;
  introQuote?: string;
  introQuoteAttribution?: string;
  publishDate?: Date;
  acknowledgements?: string[];
}

const props = Astro.props;
---

<EssayLayout {...props} bodyClass="photo-essay">
  <slot />
</EssayLayout>

<style is:global>
  /*
    Photo-essay-specific overrides. Scope rules to `body.photo-essay` so they
    only apply on photo-essay pages. EssayLayout owns the base `.post-*` and
    `.page-essay__*` markup; override its classes here as needed.
  */
  body.photo-essay .post-body__prose iframe {
    display: block;
    max-width: 100%;
    border: 0;
  }

  body.photo-essay .post-body__prose iframe[src*="youtube"] {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }
</style>
