---
import { getCollection, render } from 'astro:content';
import EssayLayout from '../../layouts/EssayLayout.astro';
import PhotoEssayLayout from '../../layouts/PhotoEssayLayout.astro';

export async function getStaticPaths() {
  const essays = (await getCollection('essay')).filter((e) => !e.data.draft);
  return essays.map((essay) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);

const Layout = essay.data.photoEssay ? PhotoEssayLayout : EssayLayout;
---

<Layout
  title={essay.data.title}
  lede={essay.data.lede}
  introQuote={essay.data.introQuote}
  publishDate={essay.data.publishDate}
>
  <Content />
</Layout>
